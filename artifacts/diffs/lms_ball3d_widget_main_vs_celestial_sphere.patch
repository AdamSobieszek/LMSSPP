+    @staticmethod
+    def _projection_basis_from_pole(pole: np.ndarray, *, eps: float = 1e-12) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+        a = np.asarray(pole, dtype=np.float64).reshape(3)
+        n = float(np.linalg.norm(a))
+        if n <= eps or not np.isfinite(n):
+            a = np.array([1.0, 0.0, 0.0], dtype=np.float64)
+        else:
+            a = a / n
+        ref = np.array([0.0, 0.0, 1.0], dtype=np.float64)
+        if abs(float(np.dot(ref, a))) > 0.92:
+            ref = np.array([0.0, 1.0, 0.0], dtype=np.float64)
+        e1 = np.cross(ref, a)
+        e1 = e1 / max(float(np.linalg.norm(e1)), eps)
+        e2 = np.cross(a, e1)
+        e2 = e2 / max(float(np.linalg.norm(e2)), eps)
+        return a, e1, e2
+
+    @classmethod
+    def _spherical_inversion_project_2d(
+        cls,
+        points: np.ndarray,
+        *,
+        pole: np.ndarray,
+        omega: float = 1.0,
+        eps: float = 1e-10,
+    ) -> np.ndarray:
+        """Project C_a(x)=(x-a)/|x-a|^2 to the plane normal to boundary pole a."""
+        pts = np.asarray(points, dtype=np.float64)
+        single = pts.ndim == 1
+        arr = pts.reshape(-1, 3)
+        a, e1, e2 = cls._projection_basis_from_pole(pole, eps=eps)
+        diff = arr - a[None, :]
+        den = np.sum(diff * diff, axis=1, keepdims=True)
+        finite = den[:, 0] > float(eps)
+        y = np.full_like(diff, np.nan, dtype=np.float64)
+        y[finite] = float(omega) * diff[finite] / den[finite]
+        out = np.column_stack([y @ e1, y @ e2])
+        return out[0] if single else out
+
+    @classmethod
+    def _spherical_inversion_grid_2d(
+        cls,
+        *,
+        pole: np.ndarray,
+        omega: float,
+        theta_count: int = 8,
+        phi_count: int = 12,
+        samples: int = 192,
+    ) -> tuple[list[float | None], list[float | None]]:
+        a, e1, e2 = cls._projection_basis_from_pole(pole)
+        xs: list[float | None] = []
+        ys: list[float | None] = []
+
+        def append_curve(curve: np.ndarray) -> None:
+            uv = cls._spherical_inversion_project_2d(curve, pole=a, omega=float(omega))
+            finite = np.isfinite(uv).all(axis=1)
+            for pt, ok in zip(uv, finite, strict=True):
+                if ok:
+                    xs.append(float(pt[0]))
+                    ys.append(float(pt[1]))
+                else:
+                    xs.append(None)
+                    ys.append(None)
+            xs.append(None)
+            ys.append(None)
+
+        phi = np.linspace(0.0, 2.0 * math.pi, int(samples), endpoint=True)
+        for theta in np.linspace(0.18, math.pi - 0.18, int(theta_count)):
+            ring = (
+                math.cos(float(theta)) * a[None, :]
+                + math.sin(float(theta)) * (np.cos(phi)[:, None] * e1[None, :] + np.sin(phi)[:, None] * e2[None, :])
+            )
+            append_curve(ring)
+
+        theta = np.linspace(0.18, math.pi - 0.18, int(samples), endpoint=True)
+        for phi0 in np.linspace(0.0, 2.0 * math.pi, int(phi_count), endpoint=False):
+            u = math.cos(float(phi0)) * e1 + math.sin(float(phi0)) * e2
+            meridian = np.cos(theta)[:, None] * a[None, :] + np.sin(theta)[:, None] * u[None, :]
+            append_curve(meridian)
+        return xs, ys
